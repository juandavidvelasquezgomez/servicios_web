# Copia este archivo como .env y completa los valores entregados por el docente.
# El archivo .env nunca se sube al repositorio.

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=appdb
DB_USER=
DB_PASSWORD=

# MQTT
MQTT_ENABLED=true
MQTT_BROKER=emqx.coriotlab.co
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors/GAS-002/data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Registro de mensajes aceptados y rechazados
LOG_FILE=logs/mqtt.log
